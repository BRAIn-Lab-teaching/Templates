% ОСНОВНЫЕ ОКРУЖЕНИЯ

\NewDocumentEnvironment{mainpart}{}
{
  \ifbrain@twocolumnmode
    \twocolumn[\maketitlebox]
  \else
    \maketitlebox
  \fi
}
{
  \bibliographystyle{\brain@bibliostyle}
  \bibliography{\brain@bibfile}
  \ifbrain@twocolumnmode \onecolumn \fi
}

\NewDocumentEnvironment{appendixpart}{}
{
  \clearpage
  \appendix
  \begin{tcolorbox}[
    colback=boxcolor!15,
    colframe=boxcolor!60!black,
    width=\columnwidth,
    arc=\brain@arc,
    boxrule=\brain@boxrule,
    left=10pt, right=10pt, top=6pt, bottom=6pt,
    enhanced jigsaw,
  ]
  \centering
  \textbf{\Large Appendix} \\
  {\small Supplementary Materials for \textit{\papertitle}}
  \end{tcolorbox}
  \vspace{1em}
}
