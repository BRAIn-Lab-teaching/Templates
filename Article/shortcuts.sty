% \expect{X}, \expect_{x\sim p}{X}, \expect^{2}{X}, \expect{X | Y}
% ВНИМАНИЕ: параметры здесь одинарные (#1), а не удвоенные — команда
% определяется на верхнем уровне, а не внутри другой команды.
% ВАЖНО: команда определяется вне \ExplSyntaxOn. Внутри expl3 символ _ имеет
% каткод буквы, поэтому и спецификация e{_^}, и запись _{...} в теле молча
% перестают работать как нижний индекс.
% \SplitArgument всегда отдаёт две группы; если разделителя | не было,
% вторая равна -NoValue-. Проверять надо именно её, а не первую.
\newcommand{\brain@expect@body}[2]{%
  \IfNoValueTF{#2}{\left[ #1 \right]}{\left[ #1 \,\middle|\, #2 \right]}%
}
\NewDocumentCommand{\expect}{ e{_^} >{\SplitArgument{1}{|}} m }{%
  \mathbb{E}%
  \IfValueT{#1}{_{#1}}%
  \IfValueT{#2}{^{#2}}%
  \brain@expect@body#3%
}

