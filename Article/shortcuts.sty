% ========== Функции с индексами ==========
% \funcf, \g, \h печатают f, g, h и принимают степень, индекс и аргумент:
%   \funcf          -> f
%   \funcf^2_i(x)   -> f^2_i(x)
% Раньше в теле стояло \use:c{#1}, то есть макрос вызывал сам себя —
% это давало бесконечную рекурсию и «TeX capacity exceeded».
\newcommand{\brain@newfunc}[2]{%
  \expandafter\NewDocumentCommand\csname #1\endcsname{e{^_} D(){}}{%
    #2%
    \IfValueT{##1}{^{##1}}%
    \IfValueT{##2}{_{##2}}%
    \IfBlankF{##3}{\qty{##3}}%
  }%
}
\brain@newfunc{funcf}{f}
\brain@newfunc{g}{g}
\brain@newfunc{h}{h}

