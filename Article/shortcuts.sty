% ========== Транспонирование ==========
% Работают обе записи: \trans*(A) и \trans*{A} дают A^T,
% \trans(A+B) и \trans{A+B} дают (A+B)^T.
\newcommand{\brain@trans@bare}[1]{#1^{\top}}
\newcommand{\brain@trans@paren}[1]{\left(#1\right)^{\top}}
\NewDocumentCommand{\trans}{s d()}{%
  \IfBooleanTF{#1}
    {\IfValueTF{#2}{#2^{\top}}{\brain@trans@bare}}
    {\IfValueTF{#2}{\left(#2\right)^{\top}}{\brain@trans@paren}}%
}

