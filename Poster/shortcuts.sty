% ========== Функции с индексами ==========
% #1 - имя макроса, #2 - печатаемый символ функции.
% Использование: \funcf^{a}_{i}(x) -> f^{a}_{i}\left(x\right)
% Определяется вне \ExplSyntaxOn: там `_` имеет категорию буквы и
% спецификация e{^_} перестаёт распознавать подстрочный индекс.
\newcommand{\brainnewfunc}[2]{%
  \expandafter\NewDocumentCommand\csname #1\endcsname{ e{^_} D(){} }{%
    #2%
    \IfValueT{##1}{^{##1}}%
    \IfValueT{##2}{_{##2}}%
    \IfBlankF{##3}{\qty{##3}}%
  }%
}
\brainnewfunc{funcf}{f}
\brainnewfunc{funcg}{g}
\brainnewfunc{funch}{h}

