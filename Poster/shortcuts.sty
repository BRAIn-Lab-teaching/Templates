% \expect{X} -> E[X];  \expect_{x}{X} -> E_x[X];  \expect{X | Y} -> E[X | Y]
% ВАЖНО: определяется вне \ExplSyntaxOn, иначе `_` в спецификации e{_^}
% имеет категорию буквы и подстрочный индекс не распознаётся.
\newcommand{\brainexpectbody}[2]{%
  \IfNoValueTF{#2}%
    {\left[ #1 \right]}%
    {\left[ #1 \,\middle|\, #2 \right]}%
}
\NewDocumentCommand{\expect}{ e{_^} >{\SplitArgument{1}{|}} m }{%
  \mathbb{E}%
  \IfValueT{#1}{_{#1}}%
  \IfValueT{#2}{^{#2}}%
  \brainexpectbody#3%
}

