% --- Рисунки ---
% Стандартный figure — это float, а плавающие объекты внутри multicols
% не поддерживаются (уезжают в конец документа). Поэтому figure, как и
% table выше, переопределяется в обычное нефлотящее окружение.
% Подпись ставится через \captionof{figure}{...}.
% Отступы в рамке берутся из тех же опций, что и у таблиц (table*pad).
\newenvironment{figureplain}[1][]
{%
  \par
  \vspace{0.5em}
  \centering
}{%
  \par
  \vspace{0.5em}
}

\newenvironment{figureboxed}[1][]
{%
  \begin{braintablebox}[#1]
  \centering
}{%
  \end{braintablebox}
}

\ifbrain@boxedfigure
  \let\figure\figureboxed
  \let\endfigure\endfigureboxed
