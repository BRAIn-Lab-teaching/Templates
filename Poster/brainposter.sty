% ============================================================================
% 20. QR-КОДЫ
% ============================================================================
%
% Картинки ищутся в папке из опции qrdir (по умолчанию `qr`):
%     \usepackage[qrdir=images/qr, qrsize=7em]{brainposter}
%
% Ожидаемые файлы для \qrcodes:
%     qr/x-qr.png         - X (Twitter) лаборатории
%     qr/we-chat-qr.png   - WeChat лаборатории
%     qr/own-wechat.png   - личный WeChat докладчика
%     qr/own-tg.png       - личный Telegram докладчика
%
% Если файла нет, вместо картинки рисуется рамка-заглушка с именем файла,
% и сборка НЕ падает — постер можно верстать до того, как готовы все QR.
%
% ОСНОВНАЯ КОМАНДА:
%
%     \addqr{файл=подпись, файл=подпись, ...}
%
% Коды раскладываются автоматически: размер подбирается так, чтобы весь
% список влез в одну строку по ширине колонки (но не крупнее qrsize и не
% мельче qrminsize); если не влезает — переносится на следующую строку.
% Ряд центрируется. Подпись можно не писать: \addqr{a.png, b.png}
%
%     \addqr[8em]{...}   - свой максимальный размер
%     \qrcodes           - стандартный набор лаборатории (см. ниже)
%
% Подписи стандартного набора вынесены в макросы, переопределяйте их:
%     \renewcommand{\qrlabelowntg}{Telegram: @username}

\newcommand{\qrlabelx}{X (Twitter)}
\newcommand{\qrlabelwechat}{WeChat}
\newcommand{\qrlabelownwechat}{My WeChat}
\newcommand{\qrlabelowntg}{My Telegram}

% \qrcode[размер]{файл}{подпись} — один QR-код с подписью под ним.
% Низкоуровневый примитив; обычно достаточно \addqr.
\newcommand{\qrcode}[3][\brain@qrsize]{%
  \begin{minipage}[t]{#1}%
    \centering
    \IfFileExists{\brain@qrdir/#2}%
      {\includegraphics[width=#1]{\brain@qrdir/#2}}%
      {\brain@qrmissing{#1}{#2}}%
    \par\vspace{0.35em}
    % Подпись уже кода: разрешаем переносы и небольшой «разгон»,
    % иначе длинное слово вылезает за рамку (Overfull \hbox).
    {\small\hyphenpenalty=50 \exhyphenpenalty=50
     \emergencystretch=1.5em \hbadness=10000
     \hspace{0pt}#3\par}%
  \end{minipage}%
}

% Заглушка для отсутствующего файла: рамка с именем файла.
% \edef нужен, чтобы имя файла, приехавшее в переменной, успело раскрыться
% до \detokenize. Длинное имя не переносится (\ttfamily), поэтому если оно
% не влезает — ужимаем его \resizebox, иначе текст вылезет за рамку.
\newlength{\brain@qrdim}
\newcommand{\brain@qrmissing}[2]{%
  \begingroup
    \edef\brain@qrtmp{#2}%
    \setlength{\brain@qrdim}{\dimexpr#1-2\fboxsep-2\fboxrule\relax}%
    \sbox0{\tiny\ttfamily\expandafter\detokenize\expandafter{\brain@qrtmp}}%
    \fbox{\parbox[c][\brain@qrdim][c]{\brain@qrdim}{%
      \centering
      \ifdim\wd0>\brain@qrdim
        \resizebox{\brain@qrdim}{!}{\usebox0}%
      \else
        \usebox0
      \fi
    }}%
  \endgroup
}

\ExplSyntaxOn
\clist_new:N \l__brain_qr_clist
\seq_new:N   \l__brain_qr_pair_seq
\tl_new:N    \l__brain_qr_file_tl
\tl_new:N    \l__brain_qr_label_tl
\dim_new:N   \l__brain_qr_width_dim
\int_new:N   \l__brain_qr_count_int
\int_new:N   \l__brain_qr_gaps_int
\bool_new:N  \l__brain_qr_first_bool

% \addqr[макс. размер]{список}
\NewDocumentCommand{\addqr}{ O{\brain@qrsize} m }
{
  \clist_set:Nn \l__brain_qr_clist { #2 }
  \int_set:Nn \l__brain_qr_count_int { \clist_count:N \l__brain_qr_clist }
  \int_compare:nNnT { \l__brain_qr_count_int } > { 0 }
    { \brain_qr_render:n { #1 } }
}

\cs_new_protected:Npn \brain_qr_render:n #1
{
  % ширина, при которой все коды влезают в одну строку
  \int_set:Nn \l__brain_qr_gaps_int { \l__brain_qr_count_int - 1 }
  \dim_set:Nn \l__brain_qr_width_dim
    {
      ( \linewidth - \brain@qrgap * \l__brain_qr_gaps_int )
      / \l__brain_qr_count_int
    }
  % не крупнее заданного максимума...
  \dim_compare:nNnT { \l__brain_qr_width_dim } > { #1 }
    { \dim_set:Nn \l__brain_qr_width_dim { #1 } }
  % ...и не мельче минимума (тогда список поедет на несколько строк)
  \dim_compare:nNnT { \l__brain_qr_width_dim } < { \brain@qrminsize }
    { \dim_set:Nn \l__brain_qr_width_dim { \brain@qrminsize } }

  \par \addvspace { 0.6em }
  \begingroup
    \parindent = \c_zero_dim
    \centering
    \bool_set_true:N \l__brain_qr_first_bool
    \clist_map_inline:Nn \l__brain_qr_clist
      {
        \bool_if:NTF \l__brain_qr_first_bool
          { \bool_set_false:N \l__brain_qr_first_bool }
          { \hskip \brain@qrgap plus 0.5em minus 0.4em }
        \brain_qr_item:n { ##1 }
      }
    \par
  \endgroup
  \addvspace { 0.6em }
}

% Один элемент списка: "файл" или "файл=подпись"
\cs_new_protected:Npn \brain_qr_item:n #1
{
  \seq_set_split:Nnn \l__brain_qr_pair_seq { = } { #1 }
  \seq_pop_left:NN \l__brain_qr_pair_seq \l__brain_qr_file_tl
  \seq_pop_left:NNF \l__brain_qr_pair_seq \l__brain_qr_label_tl
    { \tl_clear:N \l__brain_qr_label_tl }
  \qrcode [ \dim_use:N \l__brain_qr_width_dim ]
          { \l__brain_qr_file_tl } { \l__brain_qr_label_tl }
}
\ExplSyntaxOff

% \qrcodes[размер] — стандартный набор лаборатории.
\newcommand{\qrcodes}[1][\brain@qrsize]{%
  \addqr[#1]{%
    x-qr.png=\qrlabelx,
    we-chat-qr.png=\qrlabelwechat,
    own-wechat.png=\qrlabelownwechat,
    own-tg.png=\qrlabelowntg%
  }%
}

% \begin{qrbox}[размер]{Заголовок} ... \end{qrbox}
% Ряд QR-кодов в фирменном боксе (как theorem/custombox).
% Пустое тело -> стандартный набор \qrcodes;
% иначе тело используется как есть (обычно там \addqr{...}).
\NewDocumentEnvironment{qrbox}{ O{\brain@qrsize} m +b }
{%
  \begin{tcolorbox}[brainstylebox, title={\textbf{#2}}]%
  \ifblank{#3}{\qrcodes[#1]}{#3}%
  \end{tcolorbox}%
}{}

% ============================================================================
% 21. БИБЛИОГРАФИЯ
% ============================================================================
%
% ВНИМАНИЕ. Пакет сам вставляет список литературы в конце документа:
% файл берётся из опции bibfile (по умолчанию references), стиль — из
% опции bibliostyle (по умолчанию plainnat). Например:
%
%     \usepackage[bibfile=mybib, bibliostyle=abbrvnat]{brainposter}
%
% Поэтому в самом .tex НЕ НУЖНО писать \bibliographystyle{...} и
% \bibliography{...} вручную: они попадут в .aux вторым экземпляром, и
% bibtex остановится с ошибкой
%     Illegal, another \bibstyle command---line N of file ....aux
% Управляйте библиографией только через опции пакета.
%
% Если файла bibfile.bib нет, блок литературы просто не выводится.
%
\AtEndDocument{
  \IfFileExists{\brain@bibfile.bib}{%
    \bibliographystyle{\brain@bibliostyle}
    \bibliography{\brain@bibfile}
  }{}
}

\endinput
