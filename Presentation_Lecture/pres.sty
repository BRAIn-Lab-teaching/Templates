\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{pres}[2025/09/30 Minimal beamer presets (venue/lang/nav)]

% ==== Dependencies ====
% encodings/lang
\RequirePackage[T1,T2A]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage[english,russian]{babel}
\RequirePackage{physics}
\RequirePackage{shortcuts}

% math
% amsxtra намеренно НЕ подключаем: он переопределяет \nobreakspace как
% \unskip\nobreak\ \ignorespaces, из-за чего ~ съедает предшествующий пробел
% (видно на \pdflink). Пакет — легаси-совместимость с AMS-LaTeX 1.1.
\RequirePackage{amsmath,amsfonts,amsthm,amssymb,amsbsy,amstext,amscd}
\RequirePackage{mathtools}
\RequirePackage{units}

% graphics / colors
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\usetikzlibrary{positioning,calc,automata,arrows.meta}
\RequirePackage{tcolorbox}
\RequirePackage{svg} % требует --shell-escape и inkscape при реальном \includesvg
% \RequirePackage{pstricks} % НЕ совместим с pdflatex; включать только под latex+dvips/xelatex

% layout / tables / floats
\RequirePackage{multicol}
\RequirePackage{multirow}
\RequirePackage{tabularx}
\RequirePackage{makecell}
\RequirePackage{wrapfig}
\RequirePackage{subfigure}
\RequirePackage{indentfirst}
\RequirePackage{verbatim}
\RequirePackage{forloop}
\RequirePackage[stable]{footmisc}
\RequirePackage[normalem]{ulem}
\RequirePackage{pifont}

% algorithms
\RequirePackage{algorithm}
\RequirePackage{algpseudocode}

% misc
\RequirePackage{etoolbox}
\RequirePackage{url}
\RequirePackage{hyperref}
