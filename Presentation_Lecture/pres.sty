% Вход/Выход внутри algorithmic. В pres-2 подписи были жёстко русскими —
% теперь берутся из \algorithmicrequire/\algorithmicensure и следуют lang=.
% Объявляются в начале документа и только если автор не объявил их сам:
% в старых презентациях под pres они часто определены в преамбуле.
\AtBeginDocument{%
  \providecommand{\AlgInput}[1]{\Statex \algorithmicrequire\ #1}%
  \providecommand{\AlgOutput}[1]{\Statex \algorithmicensure\ #1}%
}

% нумерация подписей: "Рис. 1: ..." / "Таблица 1: ..." вместо "Рис.: ..."
% (без этого beamer печатает подпись без номера и \ref на рисунок не работает)
\setbeamertemplate{caption}[numbered]

\setbeamertemplate{theorems}[unnumbered]
\newtheorem*{thm}{\NameTheorem}
\newtheorem*{lem}{\NameLemma}
\newtheorem*{defn}{\NameDefinition}
% prop появился позже thm/lem/defn, и старые презентации объявляют его сами
% (\newtheorem*{prop}{...}) — поэтому создаём его, только если его нет.
\AtBeginDocument{\ifcsundef{prop}{\newtheorem*{prop}{\NameProposition}}{}}
% Заголовок и квадратик доказательства — отдельные команды, чтобы доказательство
% можно было разорвать между кадрами: \proofhead в конце одного, \proofqed в другом.
\newcommand{\proofhead}[1][\NameProof]{\par\noindent\textit{#1.}\ }
\newcommand{\proofqed}{\hfill$\square$\par}
\renewenvironment{proof}[1][\NameProof]{\proofhead[#1]}{\proofqed}

