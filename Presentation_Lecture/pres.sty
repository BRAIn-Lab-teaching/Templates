% ==== Strict options (NO fallbacks) ====
\newcommand*\bb@venue{fpmi}
\newcommand*\bb@lang{ru}
\newcommand*\bb@nav{show}

\DeclareOption{venue=fpmi}{\renewcommand*\bb@venue{fpmi}}
\DeclareOption{venue=innopolis}{\renewcommand*\bb@venue{innopolis}}
\DeclareOption{venue=isp}{\renewcommand*\bb@venue{isp}}

\DeclareOption{lang=ru}{\renewcommand*\bb@lang{ru}}
\DeclareOption{lang=en}{\renewcommand*\bb@lang{en}}

\DeclareOption{navsymbols=show}{\renewcommand*\bb@nav{show}}
\DeclareOption{navsymbols=hide}{\renewcommand*\bb@nav{hide}}

% ANY other option -> HARD ERROR
\DeclareOption*{%
  \PackageError{brainbeamer}{Unknown option `\CurrentOption'}%
  {Allowed options: venue=fpmi|innopolis|isp, lang=ru|en, navsymbols=show|hide.}%
}
\ProcessOptions\relax

% ==== Theme skeleton (assumes \documentclass{beamer}) ====
\mode<presentation>{\usetheme{Madrid}}
\useoutertheme[subsection=false]{miniframes}
\useinnertheme{circles}

% ==== Language + fonts encodings responsibility stays in main .tex ====

% ==== Institute / Logo exports (user can override in .tex) ====
\providecommand*\InstituteLong{Московский физико-технический институт}
\newcommand*\LogoPath{} % set by venue

% ==== Palette ====
% Vintage Berry / Apricot Cream / Papaya Whip / Floral White
\definecolor{berry}{HTML}{8D4865}
\definecolor{apricot}{HTML}{F7C57C}
\definecolor{papaya}{HTML}{FBEDD6}
\definecolor{floral}{HTML}{FBF8F1}
% производные оттенки — нужны только для читаемости мелкого текста на светлом фоне
\definecolor{inkBerry}{HTML}{3A2233}  % тёмная «ягода» для основного текста
\definecolor{amber}{HTML}{8A5A12}     % затемнённый Apricot: ссылки и второй акцент
\definecolor{berryLight}{HTML}{B87A94} % осветлённая «ягода» для тонких линий
% статусные цвета (вне палитры: нужны для \cmark/\xmark и предупреждений)
\definecolor{statusOk}{HTML}{4C7A3F}
\definecolor{statusBad}{HTML}{B03A48}

% ==== Semantic roles (значения по умолчанию = как в исходном стилевике) ====
\definecolor{primary}{rgb}{0.2,0.2,0.6}
\definecolor{secondary}{rgb}{1,0.49,0.0}
\definecolor{onPrimary}{rgb}{1,1,1}
\definecolor{onSecondary}{rgb}{1,1,1}
\colorlet{accent}{primary}      % второй акцент (ссылки, \redstuff)
\colorlet{surface}{black!4}     % подложка блоков/боксов
\colorlet{background}{white}    % фон слайда
\colorlet{ink}{black}           % основной текст
\colorlet{badgeFill}{red}       % заливка бейджа \PDFbadge
\colorlet{badgeText}{white}

% Расширенное оформление (светлый фон, плашки, полоска на титуле) включается
% только для venue=fpmi; isp и innopolis остаются в своём фирменном виде.
\newbool{bb@newstyle}

% ==== Venue presets ====
\expandafter\ifstrequal\expandafter{\bb@venue}{fpmi}{%
  \booltrue{bb@newstyle}%
  \colorlet{primary}{berry}%
  \colorlet{secondary}{apricot}%
  \colorlet{accent}{amber}%
  \colorlet{surface}{papaya}%
  \colorlet{background}{floral}%
  \colorlet{ink}{inkBerry}%
  \definecolor{onPrimary}{HTML}{FBF8F1}%
  \colorlet{onSecondary}{inkBerry}%
  \colorlet{badgeFill}{berry}%
  \colorlet{badgeText}{onPrimary}%
  \renewcommand*\InstituteLong{Московский физико-технический институт}%
  \renewcommand*\LogoPath{logos/fpmi.png}%
}{%
\expandafter\ifstrequal\expandafter{\bb@venue}{innopolis}{%
  \definecolor{primary}{RGB}{64,187,32}%
  \definecolor{secondary}{RGB}{19,21,42}%
  \renewcommand*\InstituteLong{Innopolis University}%
  \renewcommand*\LogoPath{logos/innopolis.png}%
}{
\expandafter\ifstrequal\expandafter{\bb@venue}{isp}{%
  \definecolor{primary}{RGB}{3,91,169}%
  \definecolor{secondary}{RGB}{255,255,255}%
  \definecolor{onSecondary}{rgb}{0,0,0}%
  \renewcommand*\InstituteLong{ИСП РАН}%
  \renewcommand*\LogoPath{logos/isp.png}%
}{
  \PackageError{brainbeamer}
        {Invalid value for option `venue`: \bb@venue}
        {Allowed values: venue=fpmi|innopolis.}%
}}}

% ==== Beamer color bindings (общие для всех venue — как в исходном стилевике) ====
% top bar (sections) — color only, без заливки подложки
\setbeamercolor{section in head/foot}{parent=,bg=secondary,fg=onSecondary}
\setbeamercolor{title in head/foot}{parent=,bg=primary,fg=onPrimary}
\setbeamercolor{palette primary}{bg=primary,fg=onPrimary}
\setbeamercolor{palette secondary}{bg=secondary,fg=onSecondary}
\setbeamercolor{palette tertiary}{bg=primary,fg=onPrimary}
\setbeamercolor{palette quaternary}{bg=primary,fg=onPrimary}
\setbeamercolor{structure}{fg=primary}
\setbeamercolor{section in toc}{fg=primary}

% ==== Оформление ФПМИ (venue=fpmi): светлый фон, плашки, акценты ====
\ifbool{bb@newstyle}{%
  % фон и основной текст
  \setbeamercolor{normal text}{bg=background,fg=ink}
  \setbeamercolor{background canvas}{bg=background}
  \setbeamercolor{alerted text}{fg=accent}

  % верхняя панель (miniframes) и нижний колонтитул
  \setbeamercolor{subsection in head/foot}{parent=,bg=surface,fg=ink}
  \setbeamercolor{author in head/foot}{parent=,bg=primary,fg=onPrimary}
  \setbeamercolor{date in head/foot}{parent=,bg=primary,fg=onPrimary}
  \setbeamercolor{palette tertiary}{bg=surface,fg=ink}

  % заголовки
  \setbeamercolor{frametitle}{bg=primary,fg=onPrimary}
  \setbeamercolor{framesubtitle}{parent=,fg=primary}
  % название лекции на титуле — плашка Apricot Cream под текстом
  \setbeamercolor{title}{parent=,bg=secondary,fg=primary}
  \setbeamercolor{subtitle}{fg=accent}
  \setbeamercolor{author}{fg=ink}
  \setbeamercolor{institute}{fg=ink}
  \setbeamercolor{date}{fg=ink}
  \setbeamercolor{titlelike}{parent=,fg=primary}

  % блоки, теоремы, примеры
  \setbeamercolor{block title}{bg=primary,fg=onPrimary}
  \setbeamercolor{block body}{bg=surface,fg=ink}
  \setbeamercolor{block title alerted}{bg=accent,fg=onPrimary}
  \setbeamercolor{block body alerted}{bg=secondary!25!background,fg=ink}
  \setbeamercolor{block title example}{bg=secondary,fg=onSecondary}
  \setbeamercolor{block body example}{bg=secondary!20!background,fg=ink}

  % списки, оглавление, подписи
  \setbeamercolor{item}{fg=primary}
  \setbeamercolor{subitem}{fg=accent}
  \setbeamercolor{subsubitem}{fg=accent}
  \setbeamercolor{caption name}{fg=primary}
  \setbeamercolor{subsection in toc}{fg=ink}
  \setbeamercolor{bibliography item}{fg=primary}

  % ссылки
  % NB: глобальный colorlinks не включаем — в beamer он красит и элементы
  % навигации, которые лежат на цветных плашках (шапка/колонтитул).
  % Внешние ссылки подкрашиваются точечно — см. \pdflink ниже.
  \setbeamercolor{button}{bg=surface,fg=primary}
  \setbeamercolor{button border}{fg=primary}
}{}

% ==== Defaults for tcolorbox / tikz (берут цвета текущего venue) ====
\tcbset{
  presbox/.style={
    colback=surface, colframe=primary, coltitle=onPrimary,
    colbacktitle=primary, boxrule=0.6pt, arc=2pt,
    fonttitle=\bfseries, left=6pt, right=6pt, top=4pt, bottom=4pt
  },
}
\tcbset{presbox}
\tikzset{
  presnode/.style={draw=primary, fill=surface, text=ink,
                   rounded corners=2pt, inner sep=4pt, line width=0.6pt},
  presedge/.style={draw=primary, -{Stealth[length=2mm]}, line width=0.6pt},
}

% бордовая полоска под верхним колонтитулом — только на титульном слайде и
% только для venue=fpmi. Флаг ставит шаблон титула, снимает footline (он
% раскрывается после headline), поэтому привязки к номеру страницы не нужно.
\ifbool{bb@newstyle}{%
  \setbeamercolor{headline rule}{parent=,bg=primary,fg=primary}
  \newbool{bb@titleframe}
  \addtobeamertemplate{title page}{\global\booltrue{bb@titleframe}}{}
  \addtobeamertemplate{headline}{}{%
    \ifbool{bb@titleframe}{%
      \hbox{\begin{beamercolorbox}[wd=\paperwidth,ht=2.2pt,dp=0pt]{headline rule}\end{beamercolorbox}}%
    }{}%
  }
  \addtobeamertemplate{footline}{}{\global\boolfalse{bb@titleframe}}
}{}

% nav symbols (tiny buttons, not the miniframes bar)
\expandafter\ifstrequal\expandafter{\bb@nav}{hide}{\setbeamertemplate{navigation symbols}{}}{}

% ==== Theorems / Algorithm captions per language ====
\newcommand*{\NameTheorem}{}
\newcommand*{\NameLemma}{}
\newcommand*{\NameDefinition}{}
\newcommand*{\NameProof}{}

\expandafter\ifstrequal\expandafter{\bb@lang}{ru}{%
  \renewcommand*{\NameTheorem}{Теорема}
  \renewcommand*{\NameLemma}{Лемма}
  \renewcommand*{\NameDefinition}{Определение}
  \renewcommand*{\NameProof}{Доказательство}
  \makeatletter\renewcommand{\ALG@name}{Алгоритм}\makeatother
  \renewcommand{\algorithmicrequire}{\textbf{Вход:}}
  \renewcommand{\algorithmicensure}{\textbf{Выход:}}
  \AtBeginDocument{\renewcommand{\figurename}{Рис.}\renewcommand{\tablename}{Таблица}}
}{\expandafter\ifstrequal\expandafter{\bb@lang}{en}{%
  \renewcommand*{\NameTheorem}{Theorem}
  \renewcommand*{\NameLemma}{Lemma}
  \renewcommand*{\NameDefinition}{Definition}
  \renewcommand*{\NameProof}{Proof}
  \makeatletter\renewcommand{\ALG@name}{Algorithm}\makeatother
  \renewcommand{\algorithmicrequire}{\textbf{Input:}}
  \renewcommand{\algorithmicensure}{\textbf{Output:}}
  \AtBeginDocument{\renewcommand{\figurename}{Figure}\renewcommand{\tablename}{Table}}
}{
  \PackageError{brainbeamer}
        {Invalid value for option `venue`: \bb@lang}
        {Allowed values: venue=en|ru.}%
}}

% нумерация подписей: "Рис. 1: ..." / "Таблица 1: ..." вместо "Рис.: ..."
% (без этого beamer печатает подпись без номера и \ref на рисунок не работает)
\setbeamertemplate{caption}[numbered]

\setbeamertemplate{theorems}[unnumbered]
\newtheorem*{thm}{\NameTheorem}
\newtheorem*{lem}{\NameLemma}
\newtheorem*{defn}{\NameDefinition}
\renewenvironment{proof}[1][\NameProof]{\par\noindent\textit{#1.}\ }{\hfill$\square$\par}

\makeatletter
\renewcommand{\thealgorithm}{} % пустой счётчик
\renewcommand{\fnum@algorithm}{\ALG@name} % подпись без номера
\makeatother

% ==== Text / math shortcuts ====
\newcommand{\Exp}{\mathbf{E}}
\newcommand{\eqdef}{\stackrel{\text{def}}{=}}
\newcommand{\ve}[2]{\left\langle #1 , #2 \right\rangle}
\def\<#1,#2>{\left\langle #1,#2\right\rangle}

% пометки в тексте (в цветах палитры)
\newcommand{\oldstuff}[1]{{\small \color{primary} #1}}
\newcommand{\redstuff}[1]{{\small \color{statusBad} #1}}

% галочка / крестик
\newcommand{\cmark}{{\color{statusOk}\ding{51}}}%
\newcommand{\xmark}{{\color{statusBad}\ding{55}}}%

\newcommand\blfootnote[1]{%
\begingroup
\renewcommand\thefootnote{}\footnote{#1}%
\addtocounter{footnote}{-1}%
\endgroup
}

\newcommand{\PDFbadge}{%
  \tikz[baseline=-0.6ex]{\node[
    draw, draw=badgeText,rounded corners=1pt,inner sep=2.5pt,outer sep=0pt,
    line width=0.4pt,text=badgeText,fill=badgeFill]{\scriptsize PDF};}
}
% для fpmi подпись подкрашена акцентом, для остальных venue — как в исходнике
\ifbool{bb@newstyle}{%
  \newcommand{\pdflink}[2]{\vfill\href{#2}{\PDFbadge~\footnotesize\color{accent} #1}\par\vspace{0.2em}}
}{%
  \newcommand{\pdflink}[2]{\vfill\href{#2}{\PDFbadge~\footnotesize #1}\par\vspace{0.2em}}
}

\titlegraphic{\includegraphics[height=0.8cm]{\LogoPath}}
\institute[]{\InstituteLong}

