% braket подключается ПОСЛЕ physics и молча перекрывает \bra/\ket своими
% версиями (он определяет их через \def). Отключается опцией braket=off.
% Чтобы не ломать презентации, написанные под physics, \braket понимает оба
% синтаксиса: \braket{a|b} (braket) и \braket{a}{b} (physics).
\ifdefstring{\bb@braket}{on}{%
  \RequirePackage{braket}%
  \let\bb@braket@pkg\braket % braket.sty задаёт \braket через \def, \let достаточно
