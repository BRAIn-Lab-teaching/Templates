% =====================================================================
%  Умные скобки (из pres-2): содержимое измеряется, и если оно выше
%  эталона x^{k+1+f}_f, ставятся \left..\right, иначе \bigl..\bigr.
%  Отключается опцией braces=physics — тогда \qty/\norm/\scalar
%  остаются такими, какими их определили physics/shortcuts (как в pres).
% =====================================================================
\ifdefstring{\bb@braces}{smart}{%

\newsavebox\custombraces@box
\newdimen\custombraces@cont@ht
\newdimen\custombraces@min@ht
\newif\ifcustombraces@useleft

% Минимальные скобки
\newcommand{\minleft}{\bigl}
\newcommand{\minright}{\bigr}

\newcommand{\custombraces@measure}[4]{% {mathstyle}{left}{content}{right}
  \sbox\custombraces@box{\ensuremath{#1#3}}%
  \custombraces@cont@ht=\dimexpr\ht\custombraces@box+\dp\custombraces@box\relax
  \sbox\custombraces@box{\ensuremath{#1x^{k+1 + f}_{f}}}%
  \custombraces@min@ht=\dimexpr\ht\custombraces@box+\dp\custombraces@box\relax
  \ifdim\custombraces@cont@ht>\custombraces@min@ht
    \custombraces@uselefttrue
  \else
    \custombraces@useleftfalse
  \fi
}

\newcommand{\custombraces@braces}[3]{% {left}{content}{right}
  \mathchoice
    {% \displaystyle
      \custombraces@measure{\displaystyle}{#1}{#2}{#3}%
      \ifcustombraces@useleft
        \left#1 #2 \right#3
      \else
        \minleft#1 #2 \minright#3
      \fi
    }
    {% \textstyle
      \custombraces@measure{\textstyle}{#1}{#2}{#3}%
      \ifcustombraces@useleft
        \left#1 #2 \right#3
      \else
        \minleft#1 #2 \minright#3
      \fi
    }
    {% \scriptstyle
      \custombraces@measure{\scriptstyle}{#1}{#2}{#3}%
      \ifcustombraces@useleft
        \left#1 #2 \right#3
      \else
        \minleft#1 #2 \minright#3
      \fi
    }
    {% \scriptscriptstyle
      \custombraces@measure{\scriptscriptstyle}{#1}{#2}{#3}%
      \ifcustombraces@useleft
        \left#1 #2 \right#3
      \else
        \minleft#1 #2 \minright#3
      \fi
    }
}

% \Provide... — страховка на случай, если physics/shortcuts сменят имена
% или не будут загружены: тогда \Renew... ниже не свалится с ошибкой.
\ProvideDocumentCommand\qty{ g d[] d() d|| }{}
\ProvideDocumentCommand\norm{ m }{}
\ProvideDocumentCommand\scalar{ m }{}

% Оригиналы physics сохраняем: формы, которых умные скобки не знают
% (\qty\big(..\big), \norm*{x}, \norm\Big{x}), отдаются им — иначе старые
% презентации под physics молча печатают лишние символы.
% Без \NewCommandCopy: его нет в ядре LaTeX до 2020-10 (Overleaf, TeX Live 2020),
% а \let для xparse-команд не работает. Поэтому ссылаемся на исходники physics:
% \qty — это просто \quantity, \norm — одна строка через \braces (physics.sty).
\newcommand\bb@physics@qty{\quantity}
\NewDocumentCommand\bb@physics@norm{ l m }{\braces#1{\lVert}{\rVert}{#2}}

% \bb@sizedispatch{оригинал}{умная версия}: смотрит на следующий токен
\newcommand\bb@sizedispatch[2]{%
  \def\bb@sz@orig{#1}\def\bb@sz@smart{#2}%
  \futurelet\bb@sz@next\bb@sz@dispatch}
\newcommand\bb@sz@dispatch{%
  \let\bb@sz@go\bb@sz@smart
  \ifx\bb@sz@next*\let\bb@sz@go\bb@sz@orig\fi
  \ifx\bb@sz@next\big\let\bb@sz@go\bb@sz@orig\fi
  \ifx\bb@sz@next\Big\let\bb@sz@go\bb@sz@orig\fi
  \ifx\bb@sz@next\bigg\let\bb@sz@go\bb@sz@orig\fi
  \ifx\bb@sz@next\Bigg\let\bb@sz@go\bb@sz@orig\fi
  \bb@sz@go}

\RenewDocumentCommand\qty{}{\bb@sizedispatch{\bb@physics@qty}{\bb@smart@qty}}
\RenewDocumentCommand\norm{}{\bb@sizedispatch{\bb@physics@norm}{\bb@smart@norm}}

\NewDocumentCommand\bb@smart@qty{ g d[] d() d|| }
{%
  \IfValueTF{#1}
    {{\custombraces@braces{\lbrace}{#1}{\rbrace}}}
  {%
    \IfValueTF{#2}
      {{\custombraces@braces{\lbrack}{#2}{\rbrack}}}
    {%
      \IfValueTF{#3}
        {{\custombraces@braces{\lparen}{#3}{\rparen}}}
      {%
        \IfValueTF{#4}
          {{\custombraces@braces{\lvert}{#4}{\rvert}}}
          {}%
      }%
    }%
  }%
}

\NewDocumentCommand\bb@smart@norm{ m }
{%
  \ensuremath{\mathord{\custombraces@braces{\lVert}{#1}{\rVert}}}%
}

\RenewDocumentCommand{\scalar}{m}{%
  \ensuremath{\mathord{\custombraces@braces{\langle}{#1}{\rangle}}}%
}
}{}

% ==== Exports users may want to use in main ====
% \InstituteLong, \InstituteShort, \LogoPath available to \titlegraphic etc.
% Цвета: primary, secondary, accent, surface, background, ink, onPrimary, onSecondary
% Стили: tcolorbox presbox, tikz presnode/presedge/dot
% Окружения: thm, lem, defn, prop, proof (+ \proofhead/\proofqed для разрыва)
% Команды: \Exp \eqdef \ve \< , > \oldstuff \redstuff \cmark \xmark
%          \blfootnote \PDFbadge \pdflink \AlgInput \AlgOutput
% Логотипы: \AddLogo[опции]{файл}, \ClearLogos, \LogoRow
%           параметры \LogoHeight \LogoSep \LogoMaxWidth

% =====================================================================
%  Логотипы на титуле
%
%  По умолчанию стоит один логотип площадки (\LogoPath). Дополнительные
%  добавляются в преамбуле, после \usepackage{pres}:
%
%      \AddLogo{logos/brainlab.png}
%      \AddLogo[height=1.1cm]{logos/iii.pdf}   % своя высота
%      \AddLogo[width=2cm]{logos/wide.png}     % широкий логотип — по ширине
%
%  Порядок вывода = порядок вызовов, логотип площадки идёт первым.
%  \ClearLogos убирает всё, включая логотип площадки, — если нужен
%  совсем другой набор:
%
%      \ClearLogos
%      \AddLogo{logos/a.png}\AddLogo{logos/b.png}
%
%  Настройки: \LogoHeight (высота по умолчанию), \LogoSep (промежуток),
%  \LogoMaxWidth (если ряд шире — он целиком ужимается до этой ширины).
% =====================================================================
\newcommand*\LogoHeight{0.8cm}
\newcommand*\LogoSep{1.2em}
\newcommand*\LogoMaxWidth{0.9\paperwidth}

\newsavebox\bb@logobox
\newcommand*\bb@logolist{}

% один логотип: [опции \includegraphics]{файл}. Логотипы центрируются друг
% относительно друга по вертикали, поэтому разная высота выглядит опрятно.
\newcommand{\bb@logo}[2]{%
  \edef\bb@logo@path{#2}%
  \ifdefempty{\bb@logo@path}{}{%
    \raisebox{-0.5\height}{%
      \ifblank{#1}%
        {\includegraphics[height=\LogoHeight]{#2}}%
        {\includegraphics[#1]{#2}}%
    }%
  }%
}

\newcommand{\AddLogo}[2][]{%
  \ifdefempty{\bb@logolist}{}{\appto\bb@logolist{\hspace{\LogoSep}}}%
  \eappto\bb@logolist{\noexpand\bb@logo{\unexpanded{#1}}{\unexpanded{#2}}}%
}
\newcommand{\ClearLogos}{\renewcommand*\bb@logolist{}}

% ряд логотипов; если не влезает по ширине — ужимается целиком, с пропорциями
\newcommand{\LogoRow}{%
  \sbox\bb@logobox{\bb@logolist}%
  \ifdim\wd\bb@logobox>\LogoMaxWidth\relax
    \resizebox{\LogoMaxWidth}{!}{\usebox\bb@logobox}%
  \else
    \usebox\bb@logobox
  \fi
}

% логотип площадки — первый в ряду. \LogoPath не разворачивается здесь,
% поэтому его можно переопределить в .tex уже после \usepackage{pres}.
\AddLogo{\LogoPath}

\titlegraphic{\LogoRow}
\institute[]{\InstituteLong}

% Done.