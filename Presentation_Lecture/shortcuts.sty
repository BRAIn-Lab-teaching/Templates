% Транспонирование
\NewDocumentCommand{\trans}{s d()}{%
  \ensuremath{%
    \IfBooleanTF{#1}{%
      % Если звездочка указана: без скобок
      #2^\top%
    }{%
      % Если звездочка не указана: с масштабируемыми скобками
      \left( #2 \right)^\top%
    }%
  }%
}

% Определение скалярного произведения
